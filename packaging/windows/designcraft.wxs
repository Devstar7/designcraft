<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?ifndef HasCraftFontLicences ?>
  <?define HasCraftFontLicences=0 ?>
  <?endif?>
  <Package Name="STAR Design" Manufacturer="STAR7" Version="$(var.Version)" UpgradeCode="49E87D30-BB68-4896-AA1D-F45C833CFC3C" Scope="perUserOrMachine" Compressed="yes" Language="1033">
    <SummaryInformation Description="STAR Design page layout and publishing" Manufacturer="STAR7" />
    <?include $(sys.SOURCEFILEDIR)install-policy.wxi?>
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of STAR Design is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="DesigncraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="DesigncraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://suite.star-7.app.br" />
    <Property Id="ARPURLUPDATEINFO" Value="https://suite.star-7.app.br" />
    <Property Id="ARPHELPLINK" Value="https://suite.star-7.app.br" />

    <!-- Shared native setup UI, including install/uninstall completion. -->

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="STAR Design" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <!-- STAR7: desktop shortcut created automatically on install, removed on uninstall. -->
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="STAR Design" Level="1">
      <?if $(var.HasCraftFontLicences) = 1 ?>
      <ComponentGroupRef Id="CraftFontLicences" />
      <?endif?>
      <ComponentGroupRef Id="DesigncraftFiles" />
      <ComponentGroupRef Id="CraftInstallerSettings" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
    <!-- Shared full UI; app installation policy remains below. -->
    <UIRef Id="CraftInstallerUI" />
  </Package>

  <Fragment>
    <?if $(var.HasCraftFontLicences) = 1 ?>
    <ComponentGroup Id="CraftFontLicences" Directory="INSTALLFOLDER">
      <Files Include="$(var.DocsDir)\**" />
    </ComponentGroup>
    <?endif?>
    <ComponentGroup Id="DesigncraftFiles" Directory="INSTALLFOLDER">
      <Component Id="DesigncraftNotice">
        <File Id="DesigncraftNoticeFile" Source="$(var.BinDir)\NOTICE" KeyPath="yes" />
      </Component>
      <Component Id="DesigncraftApp" Guid="DE018EF3-EE87-4E36-9F76-0B7B060A195E">
        <File Id="DesigncraftExe" Source="$(var.BinDir)\designcraft.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="STAR Design" Description="STAR Design page layout and publishing" WorkingDirectory="INSTALLFOLDER" Advertise="yes" Icon="DesigncraftIcon.ico" IconIndex="0" />
        </File>

        <!-- .designcraft: DesignCraft's own format; DesignCraft is its default app. -->
        <ProgId Id="Designcraft.Document" Description="STAR Design Document" Icon="DesigncraftExe" IconIndex="0">
          <Extension Id="designcraft" ContentType="application/x-designcraft">
            <Verb Id="open" Command="Open" TargetFile="DesigncraftExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <!-- IDML: offered under "Open with", never forced as the default. -->
        <ProgId Id="Designcraft.Idml" Description="IDML Document" Icon="DesigncraftExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Designcraft.Idml\shell\open\command" Value="&quot;[#DesigncraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.idml\OpenWithProgids" Name="Designcraft.Idml" Value="" Type="string" />

        <!-- "Open with" app list and the Run dialog (Win+R "designcraft"). -->
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\designcraft.exe" Name="FriendlyAppName" Value="STAR Design" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\designcraft.exe\shell\open\command" Value="&quot;[#DesigncraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\designcraft.exe\SupportedTypes" Name=".designcraft" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\designcraft.exe\SupportedTypes" Name=".idml" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\designcraft.exe" Value="[#DesigncraftExe]" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\DesignCraft" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <!-- A non-advertised shortcut in a profile folder needs an HKCU key path (ICE38, ICE43, ICE57). -->
      <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="5C1B7E2A-9D4F-4B8E-A3C6-7F2D1E9B4A60">
        <Shortcut Id="DesktopShortcut" Name="STAR Design" Description="STAR Design page layout and publishing"
            Target="[INSTALLFOLDER]designcraft.exe" WorkingDirectory="INSTALLFOLDER" Icon="DesigncraftIcon.ico" IconIndex="0" />
        <RegistryValue Root="HKCU" Key="Software\STAR7\STAR Design" Name="DesktopShortcut" Type="string" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="DesigncraftCli">
        <File Id="DesigncraftCliExe" Source="$(var.BinDir)\designcraft-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
